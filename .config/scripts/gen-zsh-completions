#!/bin/sh
# Generate zsh completions that Homebrew and zsh-completions don't provide.
# Cached in ~/.zfunc so compinit picks them up on the next shell.
set -eu

dir="${HOME}/.zfunc"
force=""
[ "${1:-}" = "--force" ] && force=1

mkdir -p "$dir"

gen() {
  name=$1
  shift
  file="$dir/_$name"

  [ -n "$force" ] || [ ! -s "$file" ] || return 0
  command -v "$1" >/dev/null 2>&1 || return 0

  if "$@" >"$file.tmp" 2>/dev/null && [ -s "$file.tmp" ]; then
    mv "$file.tmp" "$file"
  else
    rm -f "$file.tmp"
  fi
}

gen rustup rustup completions zsh
gen cargo rustup completions zsh cargo
gen mise mise completion zsh
gen opencode opencode --completions zsh
gen kubectl kubectl completion zsh
gen just just --completions zsh
gen bun bun completions
