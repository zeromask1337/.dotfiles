#!/bin/sh
# Restart the OpenCode background server with Doppler-injected env.
#
# Run at boot by the @reboot entry in .config/cron/crontab. `doppler run` needs
# the project/config scope stored under ~/.dotfiles, so we cd there first. The
# boot network may not be up yet, hence the retries.
#
# Manual run (also restarts the server serving the current session):
#   ~/.dotfiles/.config/scripts/opencode-service-restart

set -eu

cd "$HOME/.dotfiles"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/cron"
log="$state_dir/opencode-service-restart.log"
mkdir -p "$state_dir"

log_line() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$log"; }

attempt=1
while [ "$attempt" -le 5 ]; do
  if doppler run -- opencode service restart >>"$log" 2>&1; then
    log_line "restart ok (attempt $attempt)"
    exit 0
  fi
  log_line "attempt $attempt failed; retrying in 30s"
  attempt=$((attempt + 1))
  sleep 30
done

log_line "giving up after 5 attempts"
exit 1
