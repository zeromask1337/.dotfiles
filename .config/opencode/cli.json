{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "nightowl"
  },
  "plugins": [
    "@mynameistito/opencode-usage-limits@latest"
  ],
  "diffs": {
    "wrap": "word"
  },
  "tabs": {
    "layout": "vertical",
    "indicators": "status",
    "scope": "cwd",
    "mode": "on"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "grouping": "auto",
    "markdown": "rendered",
    "image_preview": true,
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.30000000000000016
  }
}
