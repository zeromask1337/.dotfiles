{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "model": "opencode-go/deepseek-v4-flash",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Windows LAN)",
      "options": {
        "baseURL": "http://10.10.10.143:11434/v1"
      },
      "models": {
        "gemma4:e4b": {
          "name": "Gemma 4 E4B (LAN)",
          "tool_call": true
        },
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B (LAN)",
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "pnpx",
        "@playwright/mcp@latest",
        "--extension"
      ],
      "environment": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "{env:PLAYWRIGHT_CHROME_TOKEN}"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": false,
      "command": [
        "pnpx",
        "chrome-devtools-mcp@latest"
      ]
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "headers": {
        "Authorization": "Bearer {env:FIRECRAWL_API_KEY}"
      }
    }
  }
}
