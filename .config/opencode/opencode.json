{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "mcp": {
    "xai": {
      "type": "local",
      "command": [
        "bun",
        "run",
        "/Users/flippy/Development/xai-mcp-server/src/index.ts",
        "--stdio"
      ],
      "environment": {
        "XAI_API_KEY": "{env:XAI_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "pnpx",
        "@playwright/mcp@latest"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": false,
      "command": [
        "pnpx",
        "chrome-devtools-mcp@latest"
      ]
    },
    "pdf-reader": {
      "type": "local",
      "enabled": false,
      "command": [
        "pnpx",
        "@sylphx/pdf-reader-mcp"
      ]
    },
    "email": {
      "type": "local",
      "enabled": false,
      "command": [
        "node",
        "/Users/flippy/.claude/mcp-servers/imap/dist/index.js"
      ]
    },
    "excel": {
      "type": "local",
      "enabled": false,
      "command": [
        "uvx",
        "excel-mcp-server",
        "stdio"
      ]
    }
  },
  "tools": {
    "email_imap_*delete*": false
  }
}
