{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "model": "opencode-go/deepseek-v4-flash",
  "mcp": {
    "xai": {
      "type": "local",
      "command": [
        "bun",
        "/Users/flippy/Development/xai-mcp-server/dist/index.js",
        "--stdio"
      ],
      "environment": {
        "XAI_API_KEY": "{env:XAI_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "pnpx",
        "@playwright/mcp@latest",
        "--extension"
      ],
      "environment": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "{env:PLAYWRIGHT_CHROME_TOKEN}"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": false,
      "command": [
        "pnpx",
        "chrome-devtools-mcp@latest"
      ]
    },
    "pdf-reader": {
      "type": "local",
      "enabled": false,
      "command": [
        "pnpx",
        "@sylphx/pdf-reader-mcp"
      ]
    },
    "email": {
      "type": "local",
      "enabled": false,
      "command": [
        "node",
        "/Users/flippy/.claude/mcp-servers/imap/dist/index.js"
      ]
    },
    "excel": {
      "type": "local",
      "enabled": false,
      "command": [
        "uvx",
        "excel-mcp-server",
        "stdio"
      ]
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/{env:FIRECRAWL_API_KEY}/v2/mcp",
      "enabled": true
    }
  },
  "tools": {
    "email_imap_*delete*": false
  }
}
