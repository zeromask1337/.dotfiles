{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "model": "opencode/claude-haiku-4-5",
    "default_agent": "plan",
    "mcp": {
        "xai-search-mcp": {
            "type": "remote",
            "url": "http://localhost:3000/mcp",
            "enabled": true
        },
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "@playwright/mcp@latest"
            ],
            "enabled": true
        }
    }
}
