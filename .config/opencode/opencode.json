{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "model": "fireworks-ai/kimi-k2.5",
    "default_agent": "plan",
    "mcp": {
        "executor": {
            "type": "local",
            "command": [
                "executor",
                "mcp"
            ],
            "environment": {}
        },
        "xai": {
            "type": "local",
            "command": [
                "bun",
                "run",
                "/Users/flippy/Development/xai-mcp-server/src/index.ts",
                "--stdio"
            ],
            "environment": {
                "XAI_API_KEY": "{env:XAI_API_KEY}"
            }
        },
        "playwright": {
            "type": "local",
            "command": [
                "pnpx",
                "@playwright/mcp@latest"
            ]
        },
    }
}
