{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "model": "opencode-go/deepseek-v4-flash",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "pnpx",
        "@playwright/mcp@latest",
        "--extension"
      ],
      "environment": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "{env:PLAYWRIGHT_CHROME_TOKEN}"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": false,
      "command": [
        "pnpx",
        "chrome-devtools-mcp@latest"
      ]
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "headers": {
        "Authorization": "Bearer {env:FIRECRAWL_API_KEY}"
      },
      "enabled": true
    }
  }
}
