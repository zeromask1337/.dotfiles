{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "model": "opencode-go/deepseek-v4.1-flash",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/private/tmp/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "{env:HOME}/.config/opencode/**",
      "effect": "allow"
    }
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Windows LAN)",
      "options": {
        "baseURL": "http://10.10.10.143:11434/v1"
      },
      "models": {
        "gemma4:e4b": {
          "name": "Gemma 4 E4B (LAN)",
          "tool_call": true
        },
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B (LAN)",
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "headers": {
        "Authorization": "Bearer {env:FIRECRAWL_API_KEY}"
      }
    },
    "cloudflare-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "davinci-resolve": {
      "type": "local",
      "enabled": true,
      "command": [
        "{env:HOME}/Library/Application Support/davinci-resolve-mcp/venv/bin/python",
        "{env:HOME}/Library/Application Support/davinci-resolve-mcp/src/server.py"
      ],
      "environment": {
        "RESOLVE_SCRIPT_API": "/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting",
        "RESOLVE_SCRIPT_LIB": "/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so",
        "PYTHONPATH": "/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting/Modules"
      }
    }
  }
}
