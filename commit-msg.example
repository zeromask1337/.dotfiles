#!/usr/bin/env bash
# This is commit hook for adding scope to conventional commits message based on folder changes was made
# Example -> feat: foo bar
# Becomes -> feat(nvim): foo bar

set -euo pipefail

MSG_FILE="$1"
MSG="$(cat "$MSG_FILE")"

# Skip autogenerated messages
if printf '%s\n' "$MSG" | grep -Eq '^(Merge |Revert |fixup! |squash! )'; then
  exit 0
fi

# Skip if already scoped: feat(nvim): ...
if printf '%s\n' "$MSG" | grep -Eq '^[a-z]+\([^)]+\)!?: '; then
  exit 0
fi

SCOPES="$(
  git diff --cached --name-only \
    | sed -n 's#^\.config/\([^/]*\)/.*#\1#p' \
    | sort -u
)"

SCOPE_COUNT="$(
  printf '%s\n' "$SCOPES" | sed '/^$/d' | wc -l | tr -d ' '
)"

# No .config scope involved
if [ "$SCOPE_COUNT" -eq 0 ]; then
  exit 0
fi

# More than one .config scope -> fail commit
if [ "$SCOPE_COUNT" -gt 1 ]; then
  echo "commit-msg: multiple .config scopes detected:" >&2
  printf '%s\n' "$SCOPES" | sed '/^$/d' | sed 's/^/  - /' >&2
  echo "Please set the commit scope manually." >&2
  echo "Example: feat(nvim): add foo plugin" >&2
  exit 1
fi

SCOPE="$(printf '%s\n' "$SCOPES" | sed -n '1p')"

# Rewrite:
# feat: msg  -> feat(nvim): msg
# feat!: msg -> feat(nvim)!: msg
NEW_MSG="$(
  printf '%s\n' "$MSG" | sed -E "s/^([a-z]+)(!)?: /\1(${SCOPE})\2: /"
)"

printf '%s\n' "$NEW_MSG" >"$MSG_FILE"
