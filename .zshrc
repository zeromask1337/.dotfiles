# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Extra user-local bins
for _dir in "$HOME/.local/bin" "$HOME/.local/share/bob/nvim-bin" "$HOME/.dotfiles/.config/scripts" "$HOME/.bun/bin"; do
  case ":$PATH:" in
    *":$_dir:"*) ;;
    *) PATH="$PATH:$_dir" ;;
  esac
done
unset _dir

# Linuxbrew (Omarchy has no Homebrew, but this box has prebuilt formulae here)
if [[ -d /home/linuxbrew/.linuxbrew/bin ]]; then
  case ":$PATH:" in
    *":/home/linuxbrew/.linuxbrew/bin:"*) ;;
    *) PATH="$PATH:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin" ;;
  esac
fi

# Completions generated by ~/.config/scripts/gen-zsh-completions (cached in ~/.zfunc)
fpath=(~/.zfunc ~/.zsh/completions $fpath)
[ -x ~/.config/scripts/gen-zsh-completions ] && ~/.config/scripts/gen-zsh-completions

export EDITOR=nvim
export FZF_COMPLETION_OPTS="--preview 'bat --style=numbers --color=always --line-range=:200 {} 2>/dev/null || sed -n \"1,200p\" {}' --preview-window=right:60%"

if [[ "$OSTYPE" == darwin* ]]; then
  # ---------------- macOS ----------------
  zstyle ':omz:update' mode auto
  zstyle ':omz:update' frequency 13
  zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
  zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
  zstyle ':completion:*:descriptions' format '[%d]'
  zstyle ':completion:*' menu no
  zstyle ':completion:*:git-checkout:*' sort false
  zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls -1 $realpath'
  zstyle ':fzf-tab:*' switch-group '<' '>'

  fpath=(
    ~/.zfunc
    ~/.zsh/completions
    /opt/homebrew/share/zsh-completions
    /opt/homebrew/share/zsh/site-functions
    $fpath
  )

  export ZSH=$HOME/.oh-my-zsh
  source $ZSH/oh-my-zsh.sh
  eval "$(starship init zsh)"
  eval "$(mise activate zsh)"
  source /opt/homebrew/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh
  source <(fzf --zsh)
  [ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
  source /opt/homebrew/opt/zsh-autosuggestions/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  bindkey '^k' autosuggest-accept

  HISTFILE=$HOME/.zhistory
  SAVEHIST=1000
  HISTSIZE=999
  setopt share_history
  setopt hist_expire_dups_first
  setopt hist_ignore_dups
  setopt hist_verify

  alias aerorc="nvim ~/.config/aerospace/aerospace.toml"
  alias fixmypackage='sudo xattr -r -c'
else
  # ---------------- Linux / Omarchy ----------------
  # Ghostty starts zsh explicitly; passwd login shell is still bash.
  export SHELL=/usr/bin/zsh

  # omarchy-zsh provides options, completion, keybindings, aliases, functions,
  # mise/starship/zoxide/fzf init, and zsh-syntax-highlighting.
  if [[ -f /usr/share/omarchy-zsh/shell/zoptions ]]; then
    source /usr/share/omarchy-zsh/shell/zoptions
    source /usr/share/omarchy-zsh/shell/all
  else
    # Fallback when omarchy-zsh is not installed
    command -v mise &>/dev/null && eval "$(mise activate zsh)"
    command -v starship &>/dev/null && eval "$(starship init zsh)"
    command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"
    [[ -f /usr/share/fzf/completion.zsh ]] && source /usr/share/fzf/completion.zsh
    [[ -f /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
  fi

  # mise's brew backend installs gdu's binary as gdu-go
  command -v gdu-go &>/dev/null && alias gdu='gdu-go'
fi

# Re-assert user-local bins ahead of mise/omarchy PATH additions
for _dir in "$HOME/.bun/bin" "$HOME/.dotfiles/.config/scripts" "$HOME/.local/share/bob/nvim-bin" "$HOME/.local/bin"; do
  [[ -d $_dir ]] || continue
  path=("$_dir" ${path:#$_dir})
done
unset _dir

# ---------------- shared personal config ----------------
alias zshrc="nvim ~/.zshrc"
alias tmuxrc="nvim ~/.config/tmux/tmux.conf"
alias ocrc="nvim ~/.config/opencode/opencode.json"
alias miserc="nvim ~/.config/mise/config.toml"
alias sshrc="nvim ~/.ssh/config"
alias hrc='hermes config edit'
alias lg="lazygit"
alias inv='nvim $(fzf -m --preview="bat --color=always {}")'

alias oc='doppler run -- opencode'
alias occ='doppler run -- opencode --continue'
alias ocr='doppler run -- opencode run'

# Push ~/.dotfiles when a shell exits (logout, exit, closed terminal).
# Throttled and locked inside the script, so multiple shells push once.
if [ -x "$HOME/.config/scripts/dotfiles-push" ]; then
  dotfiles_push_on_exit() { "$HOME/.config/scripts/dotfiles-push" >/dev/null 2>&1 || true }
  autoload -Uz add-zsh-hook
  # zsh runs zshexit on SIGHUP (terminal closed) but not on SIGTERM (logout).
  add-zsh-hook zshexit dotfiles_push_on_exit
  TRAPTERM() { dotfiles_push_on_exit; exit 143 }
fi
